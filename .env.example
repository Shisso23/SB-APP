# PredictXI frontend settings.
#
# SAFETY: everything here is compiled into the browser bundle and is PUBLIC.
# Never put an API-Football key, service-account key, or any other credential in
# this file or in any REACT_APP_* variable. Provider access happens in Django.

# Django API origin (non-secret). Leave empty to use the same origin.
REACT_APP_PREDICTXI_API_URL=http://127.0.0.1:8000

# Firebase web configuration. These values identify the project publicly and are
# safe to ship; they are not secrets. Get them from the Firebase console:
# Project settings -> Your apps -> Web app -> SDK setup and configuration.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=