DJANGO_SECRET_KEY=replace-with-a-private-random-value-at-least-50-characters-long
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://replace-user:replace-password@127.0.0.1:5432/predictxi
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=
FIREBASE_PROJECT_ID=predcitz-backend
# Relative paths resolve against backend/. Keep the key under backend/.secrets/
# (git-ignored, mode 600). Never commit it and never paste its contents anywhere.
FIREBASE_CREDENTIALS_FILE=.secrets/firebase-service-account.json
# The provider key is BACKEND-ONLY. Leave empty until a rotated key is approved.
API_FOOTBALL_KEY=
PREDICTXI_INGESTION_ENABLED=False
PREDICTXI_LEAGUES=
PREDICTXI_JOB_REQUESTS=100
PREDICTXI_REQUESTS_PER_MINUTE=20
PREDICTXI_REQUESTS_PER_DAY=500
PREDICTXI_JOB_SECONDS=180
PREDICTXI_JOB_FIXTURES=20

# ---------------------------------------------------------------------------
# Voucher access-pass providers (Phase 5)
#
# Three INDEPENDENT providers, each DISABLED by default. Enabling one never
# enables another. Do NOT enable any provider until official merchant
# redemption documentation exists AND the provider has confirmed in writing
# that paid football-prediction analytics is an accepted merchant category.
#
# No endpoints, credentials, signatures or voucher formats belong here until
# they have been documented by the provider. Voucher PINs are never config.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER_ONEVOUCHER_ENABLED=False
PAYMENT_PROVIDER_OTT_ENABLED=False
PAYMENT_PROVIDER_BLU_ENABLED=False