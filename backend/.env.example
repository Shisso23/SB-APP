DJANGO_SECRET_KEY=replace-with-a-private-random-value-at-least-50-characters-long
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://replace-user:replace-password@127.0.0.1:5432/predictxi
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=
FIREBASE_PROJECT_ID=predcitz-backend
# Relative paths resolve against backend/. Keep the key under backend/.secrets/
# (git-ignored, mode 600). Never commit it and never paste its contents anywhere.
FIREBASE_CREDENTIALS_FILE=.secrets/firebase-service-account.json
# The provider key is BACKEND-ONLY. Leave empty until a rotated key is approved.
API_FOOTBALL_KEY=
PREDICTXI_INGESTION_ENABLED=False
PREDICTXI_LEAGUES=
PREDICTXI_JOB_REQUESTS=100
PREDICTXI_REQUESTS_PER_MINUTE=20
PREDICTXI_REQUESTS_PER_DAY=500
PREDICTXI_JOB_SECONDS=180
PREDICTXI_JOB_FIXTURES=20

# ---------------------------------------------------------------------------
# Voucher access-pass providers (Phase 5)
#
# Three INDEPENDENT providers, each DISABLED by default. Enabling one never
# enables another. Do NOT enable any provider until official merchant
# redemption documentation exists AND the provider has confirmed in writing
# that paid football-prediction analytics is an accepted merchant category.
#
# No endpoints, credentials, signatures or voucher formats belong here until
# they have been documented by the provider. Voucher PINs are never config.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER_ONEVOUCHER_ENABLED=False
PAYMENT_PROVIDER_OTT_ENABLED=False
PAYMENT_PROVIDER_BLU_ENABLED=False

# ---------------------------------------------------------------------------
# PayFast (Phase 6) - paid access passes for premium predictions
#
# BACKEND-ONLY CREDENTIALS. Never put these in frontend code, a bundle, or a
# public config endpoint. Leave the values EMPTY here; supply them per
# environment. PAYFAST_ENABLED must be True for checkout to be reachable.
#
# Sandbox setup:
#   1. Register at https://sandbox.payfast.co.za and set a "Salt Passphrase".
#   2. PAYFAST_PROCESS_URL / PAYFAST_VALIDATE_URL use sandbox.* while testing;
#      switch both hosts to www.payfast.co.za for live.
#   3. PREDICTXI_SITE_URL must be a PUBLICLY reachable HTTPS origin (PayFast
#      only connects to ports 80/8080/8081/443), e.g. an ngrok/Expose tunnel in
#      development. PayFast posts the ITN there and redirects the buyer there.
#
# There is deliberately no default merchant id/key/passphrase: unset means the
# integration refuses to start a checkout rather than sending unsigned or
# misdirected payment data.
# ---------------------------------------------------------------------------
PAYFAST_ENABLED=False
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_PROCESS_URL=https://sandbox.payfast.co.za/eng/process
PAYFAST_VALIDATE_URL=https://sandbox.payfast.co.za/eng/query/validate
PREDICTXI_SITE_URL=
# Comma-separated CIDRs PayFast posts ITNs from (documented ranges). Override
# only if PayFast publishes an update.
PAYFAST_NOTIFY_NETWORKS=197.97.145.144/28,41.74.179.192/27,102.216.36.0/28,102.216.36.128/28,144.126.193.139/32
# PayFast's documented live minimum is ZAR 5.00.
PAYFAST_MIN_AMOUNT=5.00